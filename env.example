# Copia este archivo como ".env" (mismo directorio que docker-compose.yml) y ajusta si quieres.
# Si no creas el .env, se usan los defaults originales del script.

# Segundos entre capturas
CAPTURE_INTERVAL_SEC=60

# Horas por "ciclo interno" del script (al terminar, simplemente empieza otro ciclo, así que
# este valor solo afecta cada cuánto se reinician los contadores internos, no la duración total)
TOTAL_HOURS=240

# Cada cuántas capturas exitosas se escribe a disco
FLUSH_EVERY=10

# Timeout de la request HTTP en segundos
REQUEST_TIMEOUT_SEC=20
